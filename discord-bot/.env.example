# Copy this file to discord-bot/.env and fill in your own values.
# Run `npm -C discord-bot run bot` with no token to print full setup steps.

# Required. Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Channels the bot reads for passive capture and /scrape, comma-separated.
# Enable Developer Mode in Discord, then right-click a channel -> Copy Channel ID.
SPONSORSHIP_CHANNEL_IDS=

# Optional. Restricts slash-command registration to a single server, which
# makes commands appear instantly instead of taking up to an hour to roll out.
DISCORD_GUILD_ID=

# Optional. Channel for the daily digest of overdue / due-today next actions.
# When set, Mondays also get a weekly pipeline scoreboard post.
DIGEST_CHANNEL_ID=

# Optional. Local hour (0-23) to post the daily digest. Defaults to 8.
DIGEST_HOUR=8

# Optional. Maps next-action owner names to Discord user IDs so the digest
# @-mentions people on their overdue items. Format: name=id,name=id
OWNER_DISCORD_MENTIONS=
